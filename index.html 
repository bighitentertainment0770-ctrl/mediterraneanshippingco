<style>
  :root{
    --deep:#0a2f3a;
    --deeper:#06222b;
    --sea:#1f6f78;
    --foam:#e4efec;
    --paper:#f7faf9;
    --sun:#f4b63f;
    --ink:#10252b;
    --line:rgba(10,47,58,.18);
    --display:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;
    --body:"Newsreader",Georgia,"Times New Roman",serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--body);font-size:1.125rem;line-height:1.65;color:var(--ink);background:var(--paper);-webkit-font-smoothing:antialiased}
  a{color:inherit}
  :focus-visible{outline:3px solid var(--sun);outline-offset:3px;border-radius:2px}
  .wrap{width:min(1120px,100% - 2.5rem);margin-inline:auto}
  h1,h2,h3{font-family:var(--display);line-height:1.02;letter-spacing:-.025em}

  /* Header */
  header.top{position:absolute;inset:0 0 auto 0;z-index:5;padding:1.25rem 0}
  header.top .wrap{display:flex;justify-content:space-between;align-items:center;gap:1rem}
  .brand{font-family:var(--display);font-weight:800;font-size:1.05rem;letter-spacing:-.01em;text-decoration:none;color:#fff}
  .brand span{color:var(--sun)}
  nav{display:flex;gap:1.5rem;font-family:var(--display);font-size:.95rem}
  nav a{color:#fff;text-decoration:none;opacity:.85}
  nav a:hover{opacity:1;text-decoration:underline;text-underline-offset:5px;text-decoration-color:var(--sun)}

  /* Hero */
  .hero{position:relative;background:var(--deep);color:#fff;overflow:hidden;padding:8rem 0 4rem;min-height:92vh;display:flex;align-items:center}
  .hero::before{
    content:"";position:absolute;inset:0;opacity:.5;
    background:repeating-radial-gradient(ellipse 140% 90px at 20% 120%,transparent 0 22px,rgba(255,255,255,.045) 23px 24px);
  }
  .hero .wrap{position:relative;display:grid;grid-template-columns:1.05fr 1fr;gap:2rem;align-items:center}
  .hero h1{font-size:clamp(2.4rem,5.6vw,4.8rem);font-weight:800}
  .hero h1 small{display:block;font-size:.34em;font-weight:400;letter-spacing:0;color:var(--sun);margin-bottom:1.1rem;font-family:var(--body);font-style:italic}
  .hero p.lead{margin-top:1.6rem;max-width:30rem;color:#cfe1de;font-size:1.25rem}
  .cta-row{margin-top:2.2rem;display:flex;flex-wrap:wrap;gap:.9rem}
  .btn{font-family:var(--display);font-weight:600;font-size:1rem;padding:.95rem 1.5rem;border-radius:999px;text-decoration:none;display:inline-block;transition:transform .15s ease,background .15s ease}
  .btn:active{transform:scale(.97)}
  .btn.sun{background:var(--sun);color:var(--deeper)}
  .btn.sun:hover{background:#ffc75a}
  .btn.ghost{border:1.5px solid rgba(255,255,255,.45);color:#fff}
  .btn.ghost:hover{background:rgba(255,255,255,.1)}

  .chart{width:100%;height:auto;display:block}
  .chart .route{fill:none;stroke:var(--sun);stroke-width:2.2;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;animation:draw 2.6s .4s cubic-bezier(.6,.1,.2,1) forwards}
  .chart .route:nth-of-type(2){animation-delay:.9s}
  .chart .route:nth-of-type(3){animation-delay:1.4s}
  .chart .route:nth-of-type(4){animation-delay:1.9s}
  .chart .port{fill:var(--deep);stroke:#fff;stroke-width:2}
  .chart .home{fill:var(--sun);stroke:#fff;stroke-width:2}
  .chart text{font-family:var(--display);font-size:13px;fill:#d8e8e5}
  .chart text.homelabel{fill:#fff;font-weight:800;font-size:15px}
  .chart .grid{stroke:rgba(255,255,255,.1);stroke-width:1;fill:none}
  .chart .ring{fill:none;stroke:var(--sun);stroke-width:1.5;transform-box:fill-box;transform-origin:center;animation:ping 2.8s 2.4s ease-out infinite;opacity:0}
  @keyframes draw{to{stroke-dashoffset:0}}
  @keyframes ping{0%{transform:scale(.6);opacity:.9}100%{transform:scale(3);opacity:0}}
  .chart-note{font-size:.9rem;color:#9fc0bc;margin-top:.6rem;font-style:italic}

  /* Sections */
  section{padding:6rem 0}
  h2{font-size:clamp(2rem,4.2vw,3.2rem);font-weight:800;max-width:16ch}
  .about{background:var(--paper)}
  .about .wrap{display:grid;grid-template-columns:1fr 1.2fr;gap:4rem;align-items:start}
  .about p+p{margin-top:1.1rem}
  .facts{margin-top:2rem;border-top:1px solid var(--line)}
  .facts div{display:flex;justify-content:space-between;gap:1rem;padding:.85rem 0;border-bottom:1px solid var(--line);font-size:1rem}
  .facts dt{font-family:var(--display);font-weight:600}
  .facts dd{text-align:right;color:#35525a}

  .offer{background:var(--foam)}
  .offer-head{display:flex;justify-content:space-between;align-items:end;gap:2rem;flex-wrap:wrap;margin-bottom:3rem}
  .offer-head p{max-width:26rem;color:#35525a}
  .services{list-style:none;border-top:2px solid var(--deep)}
  .services li{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.6fr) auto;gap:1.5rem;align-items:baseline;padding:1.6rem 0;border-bottom:1px solid var(--line);transition:background .2s}
  .services li:hover{background:rgba(255,255,255,.55)}
  .services h3{font-size:1.5rem;font-weight:600;letter-spacing:-.015em}
  .services p{color:#35525a;font-size:1.05rem}
  .tag{font-family:var(--display);font-size:.8rem;font-weight:600;padding:.3rem .75rem;border-radius:999px;border:1.5px solid var(--sea);color:var(--sea);white-space:nowrap}

  .contact{background:var(--deep);color:#fff}
  .contact .wrap{display:grid;grid-template-columns:1fr 1.15fr;gap:4rem;align-items:stretch}
  .contact h2{color:#fff}
  .contact dl{margin-top:2.2rem;display:grid;gap:1.4rem}
  .contact dt{font-family:var(--display);font-size:.95rem;color:var(--sun);font-weight:600;margin-bottom:.15rem}
  .contact dd{font-size:1.15rem;color:#e8f1ef}
  .contact dd a{text-decoration-color:var(--sun);text-underline-offset:4px}
  .ph{background:rgba(244,182,63,.16);padding:.05rem .45rem;border-radius:4px;border:1px dashed rgba(244,182,63,.7)}
  .mapbox{min-height:380px;border-radius:14px;overflow:hidden;border:1px solid rgba(255,255,255,.2);background:var(--deeper)}
  .mapbox iframe{width:100%;height:100%;min-height:380px;border:0;display:block}

  footer{background:var(--deeper);color:#8fb0ac;padding:1.8rem 0;font-size:.95rem}
  footer .wrap{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}

  /* WhatsApp */
  .wa{position:fixed;right:1.1rem;bottom:1.1rem;z-index:20;display:flex;align-items:center;gap:.6rem;background:#25d366;color:#06331a;font-family:var(--display);font-weight:600;padding:.8rem 1.15rem .8rem .95rem;border-radius:999px;text-decoration:none;box-shadow:0 8px 24px rgba(0,0,0,.28);transition:transform .15s}
  .wa:hover{transform:translateY(-2px)}
  .wa svg{width:26px;height:26px;fill:currentColor;flex:none}

  @media (max-width:880px){
    .hero{padding-top:7rem;min-height:auto}
    .hero .wrap,.about .wrap,.contact .wrap{grid-template-columns:1fr;gap:2.5rem}
    .services li{grid-template-columns:1fr;gap:.5rem}
    .tag{justify-self:start;margin-top:.4rem}
    nav a:not(:last-child){display:none}
    section{padding:4.2rem 0}
  }
  @media (max-width:420px){.wa span{display:none}.wa{padding:.85rem}}
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    .chart .route{animation:none;stroke-dashoffset:0}
    .chart .ring{animation:none}
    *{transition:none!important}
  }
</style>
